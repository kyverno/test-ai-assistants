# Copy this file to .env (same directory) and fill in real values.
# .env is git-ignored — never commit it. It is mounted into the Hermes
# container as /opt/data/.env.

# --- LLM provider ---------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Hermes container user mapping (keeps files host-readable) ------------
HERMES_UID=
HERMES_GID=

# --- GitHub App (@kyctrl-bot) ----------------------------------------------
# Created in Phase 0 step 4, after the tunnel URL exists (step 3).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/opt/data/secrets/kyctrl-bot.pem
# Shared secret GitHub signs webhook deliveries with — must match the value
# entered in the GitHub App's webhook settings.
GITHUB_WEBHOOK_SECRET=

# --- Comment-capable, non-merge GitHub token used BY BOT PROFILES ---------
# Backs the "github" MCP server in mcp.json, which every bot's toolset is
# built from. IMPORTANT: this must be a fine-grained PAT scoped to
# Contents: Read, Pull requests: Read, Issues: Read & Write, Checks: Read.
# "Read & Write" on Issues is required so bots can post comments (PR
# comments use the issues endpoint) — it is NOT the same as merge access.
# Do NOT grant Contents: Write or Pull requests: Write on this token; doing
# so would let a misconfigured toolset merge/push even though the design
# intends it can't. The only token that can ever merge a PR is GITHUB_TOKEN
# inside the GitHub Actions runner for kyctrl-auto-merge.yml, which is
# never set here and never touches Hermes.
KYCTRL_READONLY_GITHUB_TOKEN=

# --- Supply chain risk check (OPTIONAL for now) ----------------------------
# Leave blank to skip this check entirely (dependabot-policy-engine.py
# explicitly does not fail-closed on a missing key, unlike every other
# missing signal — see the script's decide()). Add a real key once you're
# past initial end-to-end testing; every check re-reads env on each run,
# no restart needed.
SOCKET_DEV_API_KEY=

# --- Hermes webhook gateway --------------------------------------------------
# Global fallback HMAC secret (per-route secrets in config.yaml take
# precedence; GITHUB_WEBHOOK_SECRET above is what actually validates
# GitHub's deliveries).
WEBHOOK_SECRET=
