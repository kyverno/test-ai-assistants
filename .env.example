# Copy this file to .env in the installed profile directory
# (~/.hermes/profiles/kyverno/.env while prototyping) and fill in real
# values. Never commit the filled-in .env.

# --- LLM provider ----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT. Scopes: Contents Read, Pull requests Read & Write,
# Issues Read & Write, Checks Read, Code scanning alerts Read, Dependabot
# alerts Read, Secret scanning alerts Read, org Members Read. No Contents
# Write, no merge/admin scope — see docs/architecture.md and config.yaml's
# toolset for why the token shouldn't be able to even if the toolset can't.
GITHUB_TOKEN=

# GitHub username of the maintainer this instance serves.
MAINTAINER_GITHUB_LOGIN=

# owner/repo this instance manages.
KYVERNO_REPO=kyverno/test-ai-assistants

# --- Slack -------------------------------------------------------------------
# Bot User OAuth Token (xoxb-*) and App-Level Token (xapp-*, Socket Mode).
# Scopes: chat:write, channels:history, channels:read, app_mentions:read.
# Subscribe to message.channels + app_mention events, then reinstall the app.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Comma-separated Slack member ID(s) allowed to use this assistant — should
# be just the installing maintainer.
SLACK_ALLOWED_USERS=

# Maintainers channel ID — read for priority signals, posted to for the
# queue. Invite the bot to it first.
SLACK_HOME_CHANNEL=
